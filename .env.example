# Server (copy the relevant vars into server/.env). Requires a local PostgreSQL server —
# create the role/database once with:
#   psql -U postgres -c "CREATE ROLE testforge WITH LOGIN PASSWORD 'testforge_dev_pw';"
#   psql -U postgres -c "CREATE DATABASE testforge OWNER testforge;"
DATABASE_URL="postgresql://testforge:testforge_dev_pw@localhost:5432/testforge?schema=public"
JWT_ACCESS_SECRET="change-me-in-production-access"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"
PORT="4000"
CLIENT_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"

# Seed
SEED_ADMIN_EMAIL="admin@testforge.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Client (Vite — must be prefixed VITE_)
VITE_API_BASE_URL="http://localhost:4000/api/v1"
