# Server (copy the relevant vars into server/.env — Prisma CLI and the app both
# resolve relative sqlite paths against server/prisma/, so DATABASE_URL stays
# "file:./dev.db" regardless of which directory you run commands from)
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="change-me-in-production-access"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"
PORT="4000"
CLIENT_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"

# Seed
SEED_ADMIN_EMAIL="admin@testforge.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Client (Vite — must be prefixed VITE_)
VITE_API_BASE_URL="http://localhost:4000/api/v1"
