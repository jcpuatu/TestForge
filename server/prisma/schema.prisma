generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so "enum-like" fields below are String,
// validated at the API boundary (Zod) and typed there as literal unions.
// Role:         ADMIN | LEAD | TESTER | VIEWER
// Priority:     LOW | MEDIUM | HIGH | CRITICAL
// CaseType:     FUNCTIONAL | SMOKE | REGRESSION | PERFORMANCE | SECURITY | USABILITY | ACCEPTANCE | OTHER
// ResultStatus: UNTESTED | PASSED | FAILED | BLOCKED | RETEST
// WebhookEvent: RUN_COMPLETED | RUN_CREATED | CASE_CREATED
// CaseTemplate: TEXT | STEPS | EXPLORATORY | BDD

// ── auth ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("TESTER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  apiKeys          ApiKey[]
  createdCases     TestCase[] @relation("CaseCreatedBy")
  createdRuns      TestRun[]  @relation("RunCreatedBy")
  createdPlans     TestPlan[] @relation("PlanCreatedBy")
  assignedRunCases RunCase[]  @relation("RunCaseAssignee")
  results          Result[]
  auditLogs        AuditLog[]
  attachments      Attachment[]
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId          String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ── core hierarchy ────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  suites     Suite[]
  milestones Milestone[]
  plans      TestPlan[]
  runs           TestRun[]
  webhooks       Webhook[]
  labels         Label[]
  sharedStepSets SharedStepSet[]
  configGroups   ConfigGroup[]
  auditLogs      AuditLog[]
}

// Written to from a small set of key actions (see lib/audit.ts) rather than every mutation in
// the app — label edit/delete, section/suite/case delete, milestone/plan/run date changes, run
// close. A generic action-log-everything approach would need far more storage/UI thought than a
// portfolio-scale tool warrants; this covers the specific actions flagged during the audit as
// worth a paper trail (destructive or easily-second-guessed actions).
model AuditLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

// Named groups of configuration values (e.g. "Browsers": Chrome/Firefox/Safari) used to spin up
// one run per selected value when adding a run to a plan — see runs/service.ts's
// createRunsForConfigs. Deliberately simpler than real TestRail's full cross-group combination
// matrix: selecting configs across multiple groups here still yields one run per config, not a
// cartesian product across groups.
model ConfigGroup {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  configs Config[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Config {
  id            String      @id @default(cuid())
  configGroupId String
  configGroup   ConfigGroup @relation(fields: [configGroupId], references: [id], onDelete: Cascade)
  name          String
  createdAt     DateTime    @default(now())

  @@unique([configGroupId, name])
  @@index([configGroupId])
}

// Project-scoped tags for TestCase/RunCase — a lighter-weight alternative to full custom
// fields (real TestRail positions it this way explicitly). Only wired to TestCase for now;
// RunCase ("Test") labels are a natural follow-up, not built yet.
model Label {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  caseLabels TestCaseLabel[]

  @@unique([projectId, name])
  @@index([projectId])
}

model TestCaseLabel {
  id      String   @id @default(cuid())
  caseId  String
  case    TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  labelId String
  label   Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([caseId, labelId])
  @@index([caseId])
  @@index([labelId])
}

// Project-scoped, named, ordered step lists reusable across cases. Live-linked: a case
// attaching a set always reads its current `steps` at render time (never copies them in), so
// editing a set here propagates to every case using it. Contrast with a Run, which resolves
// (flattens) every attached set's steps into RunCase.stepsSnapshot once at run-creation time —
// runs must stay immutable regardless of later edits to the source case or its shared sets.
model SharedStepSet {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  steps     String // JSON-serialized array of { step, expected }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseLinks TestCaseSharedSteps[]

  @@unique([projectId, name])
  @@index([projectId])
}

model TestCaseSharedSteps {
  id              String        @id @default(cuid())
  caseId          String
  case            TestCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sharedStepSetId String
  sharedStepSet   SharedStepSet @relation(fields: [sharedStepSetId], references: [id], onDelete: Cascade)
  orderIndex      Int           @default(0)

  @@unique([caseId, sharedStepSetId])
  @@index([caseId])
  @@index([sharedStepSetId])
}

model Suite {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections Section[]
  cases    TestCase[]
  runs     TestRun[]

  @@index([projectId])
}

model Section {
  id          String    @id @default(cuid())
  suiteId     String
  suite       Suite     @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Section?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children    Section[] @relation("SectionTree")
  name        String
  description String?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cases TestCase[]

  @@index([suiteId])
  @@index([parentId])
}

model TestCase {
  id             String   @id @default(cuid())
  suiteId        String
  suite          Suite    @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  sectionId      String?
  section        Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title          String
  template       String   @default("TEXT")
  preconditions  String?
  steps          String? // JSON-serialized array of { step, expected } — TEXT template stores one entry
  expectedResult String?
  mission        String? // EXPLORATORY template only
  goals          String? // EXPLORATORY template only
  bddLines       String? // BDD template only — JSON-serialized array of { keyword, text }
  priority       String   @default("MEDIUM")
  type           String   @default("FUNCTIONAL")
  estimate       String?
  referenceLink  String?
  orderIndex     Int      @default(0)
  isDeleted      Boolean  @default(false)
  createdById    String?
  createdBy      User?    @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  runCases        RunCase[]
  labels          TestCaseLabel[]
  sharedStepLinks TestCaseSharedSteps[]
  attachments     Attachment[]

  @@index([suiteId])
  @@index([sectionId])
}

// ── planning ──────────────────────────────────────────

model Milestone {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Milestone?  @relation("MilestoneTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children    Milestone[] @relation("MilestoneTree")
  name        String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  references  String? // external ticket links, comma-separated free text (same convention as TestCase.referenceLink)
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  plans TestPlan[]
  runs  TestRun[]

  @@index([projectId])
}

model TestPlan {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  referenceId String? // external ticket link, distinct from the milestone association
  isCompleted Boolean    @default(false)
  completedAt DateTime?
  createdById String?
  createdBy   User?      @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  runs TestRun[]

  @@index([projectId])
  @@index([milestoneId])
}

// ── execution ─────────────────────────────────────────

model TestRun {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suiteId     String?
  suite       Suite?     @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  planId      String?
  plan        TestPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  configLabel String?
  includeAll  Boolean    @default(true)
  isCompleted Boolean    @default(false)
  completedAt DateTime?
  createdById String?
  createdBy   User?      @relation("RunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  runCases RunCase[]

  @@index([projectId])
  @@index([suiteId])
  @@index([planId])
  @@index([milestoneId])
}

model RunCase {
  id               String   @id @default(cuid())
  runId            String
  run              TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId           String?
  case             TestCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  titleSnapshot    String
  templateSnapshot String   @default("TEXT")
  stepsSnapshot    String? // JSON-serialized array of { step, expected }
  expectedSnapshot String?
  missionSnapshot  String?
  goalsSnapshot    String?
  bddLinesSnapshot String?
  // Added after a report-design audit found Comparison for References (and Property
  // Distribution's Type grouping) reading TestCase.referenceLink/type LIVE via the case join
  // instead of a frozen snapshot — editing a case's reference or type after a run had results
  // silently moved that run's historical data into a different report bucket, violating this
  // schema's own established snapshot-immutability principle (see titleSnapshot etc. above).
  referenceLinkSnapshot String?
  typeSnapshot          String? @default("FUNCTIONAL")
  priority         String
  status           String   @default("UNTESTED")
  assignedToId     String?
  assignedTo       User?    @relation("RunCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  results Result[]

  @@unique([runId, caseId])
  @@index([runId])
  @@index([assignedToId])
}

model Result {
  id          String   @id @default(cuid())
  runCaseId   String
  runCase     RunCase  @relation(fields: [runCaseId], references: [id], onDelete: Cascade)
  status      String
  comment     String?
  defects     String?
  version     String?
  elapsedMs   Int?
  stepResults String? // STEPS-template tests only — JSON array of { status, actual }, positionally matching RunCase.stepsSnapshot
  enteredById String?
  enteredBy   User?    @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  attachments Attachment[]

  @@index([runCaseId])
}

// Belongs to exactly one of TestCase or Result (never both, never neither) — enforced at the
// application layer since SQLite/Prisma can't express an XOR constraint declaratively. Files
// live on local disk under server/uploads/<id>-<filename> in dev; storagePath is the on-disk
// path, not served directly — GET /attachments/:id streams it back with the right Content-Type.
model Attachment {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  caseId       String?
  case         TestCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  resultId     String?
  result       Result?   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([caseId])
  @@index([resultId])
}

// ── integrations ──────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  event     String   @default("RUN_COMPLETED")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([projectId])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  statusCode   Int?
  success      Boolean
  requestBody  String
  responseBody String?
  createdAt    DateTime @default(now())

  @@index([webhookId])
}
